cmake_minimum_required(VERSION 3.20)
if(NOT license_output OR NOT agent_source OR NOT shared_prefixes)
    message(FATAL_ERROR "license_output, agent_source and shared_prefixes are required")
endif()
file(MAKE_DIRECTORY "${license_output}")
file(LOCK "${license_output}/.stage.lock" GUARD PROCESS TIMEOUT 120)
foreach(component ariaagent aria json mira openssl)
    file(REMOVE_RECURSE "${license_output}/${component}")
endforeach()
foreach(document LICENSE THIRD_PARTY_NOTICES.md)
    if(EXISTS "${agent_source}/${document}")
        configure_file("${agent_source}/${document}" "${license_output}/ariaagent/${document}" COPYONLY)
    endif()
endforeach()
foreach(prefix IN LISTS shared_prefixes)
    if(NOT IS_DIRECTORY "${prefix}/share/licenses")
        message(FATAL_ERROR "Selected shared artifact has no installed license directory: ${prefix}")
    endif()
    file(COPY "${prefix}/share/licenses/" DESTINATION "${license_output}")
endforeach()
